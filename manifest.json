{
  "manifest_version": 3,
  "name": "MirrorCanvas Spike",
  "version": "1.0",
  "description": "Spatial Intent Cockpit - CDP Live Tele-Operation Spike",
  "permissions": [
    "debugger",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Launch MirrorCanvas Spike"
  }
}
